{
  "name": "webclone-studio",
  "version": "1.0.0",
  "description": "Modern web sitesi klonlama ve analiz aracı — Windows portable masaüstü uygulaması",
  "main": "./out/main/index.js",
  "author": "Monolith Works / MonarchDevLab",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "build:portable": "npm run typecheck && electron-vite build && electron-builder --win portable",
    "postinstall": "electron-builder install-app-deps",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:setup": "npm run typecheck && electron-vite build && electron-builder --win nsis",
    "build:msi": "npm run typecheck && electron-vite build && electron-builder --win msi",
    "build:all": "npm run typecheck && electron-vite build && electron-builder --win nsis portable msi"
  },
  "dependencies": {
    "bottleneck": "^2.19.5",
    "cheerio": "^1.0.0",
    "got": "^14.4.7",
    "robots-parser": "^3.0.1",
    "sanitize-filename": "^1.6.3",
    "source-map": "^0.8.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@tailwindcss/vite": "^4.1.5",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/source-map": "^0.5.2",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "clsx": "^2.1.1",
    "electron": "^33.4.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "lucide-react": "^0.474.0",
    "postcss": "^8.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-resizable-panels": "^2.1.7",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.5",
    "typescript": "^5.8.3",
    "vite": "^6.3.4",
    "vitest": "^4.1.11",
    "zustand": "^5.0.5"
  }
}
